# Inlined at build time; surfaced in metadata.
NEXT_PUBLIC_APP_VERSION=development

# Strapi CMS REST API base URL (trailing /api).
CMS_URL=http://127.0.0.1:1337/api

# Strapi media host (no /api).
CMS_MEDIA_URL=http://127.0.0.1:1337

# Optional: omit to make unauthenticated requests (requires a public role).
CMS_API_TOKEN=

# Webhook revalidation shared secret. Must match the backend
# WEBHOOKS_SECRET_HEADER / WEBHOOKS_SECRET_HEADER_VALUE.
CMS_WEBHOOKS_SECRET_HEADER=super-secret-change-me
CMS_WEBHOOKS_SECRET_HEADER_VALUE=super-secret-change-me

# Shared with backend PREVIEW_SECRET. Kept server-only; required for Preview.
PREVIEW_SECRET=preview-secret-change me

# Canonical origin used for metadataBase, sitemap.xml and robots.txt.
SITE_URL=http://localhost:3000
