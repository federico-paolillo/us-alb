# Internal Strapi REST API URL used by the frontend server.
CMS_URL=http://backend:65101/api

# Public gateway origin for Strapi media URLs.
CMS_MEDIA_URL=http://us-alb.localhost:65102

# Optional Strapi API token for authenticated frontend requests.
CMS_API_TOKEN=987324b459e8b6087977aadcbe0f76b9c0b1023e4fc04379d174a2d9b22053dd47ca65ec1d2ab1bfad0a153b8e669d6cc7fc90607b35e3700545f0db8967f45d19087398bd696a490d68419218beafc78155ed99a8bb578304655f7ee439103cb50e7467b33a27d9a678542fe6bc3e483bb3ce8ce995fa4869367b9c61f0be2f

# Revalidation header name; must match WEBHOOKS_SECRET_HEADER below.
CMS_WEBHOOKS_SECRET_HEADER=987324b459e8b6087977

# Revalidation header value; must match WEBHOOKS_SECRET_HEADER_VALUE below.
CMS_WEBHOOKS_SECRET_HEADER_VALUE=aadcbe0f76b9c0b1023e4fc04379d174a2d9b22053dd47ca6

# Public origin for metadata, sitemap, and robots.
SITE_URL=http://us-alb.localhost:65102

# Version embedded in the public frontend build.
NEXT_PUBLIC_APP_VERSION=development

# Strapi bind address inside its container.
HOST=0.0.0.0

# Strapi port exposed only on the Compose network.
PORT=65101

# Public gateway URL used by Strapi-generated links.
SERVER_URL=http://us-alb.localhost:65102/cms

# Browser path for Strapi admin authentication cookies.
ADMIN_COOKIE_PATH=/cms/admin

# Comma-separated Strapi application signing keys.
APP_KEYS="toBeModified1,toBeModified2"

# Salt used to hash Strapi API tokens.
API_TOKEN_SALT=tobemodified

# Secret used to sign Strapi administrator sessions.
ADMIN_JWT_SECRET=tobemodified

# Salt used to hash Strapi transfer tokens.
TRANSFER_TOKEN_SALT=tobemodified

# Secret used to sign Strapi JWTs.
JWT_SECRET=tobemodified

# Key used to encrypt Strapi secrets.
ENCRYPTION_KEY=tobemodified

# Revalidation header name shared with CMS_WEBHOOKS_SECRET_HEADER.
WEBHOOKS_SECRET_HEADER=987324b459e8b6087977

# Revalidation header value shared with CMS_WEBHOOKS_SECRET_HEADER_VALUE.
WEBHOOKS_SECRET_HEADER_VALUE=aadcbe0f76b9c0b1023e4fc04379d174a2d9b22053dd47ca6

# Internal Next.js endpoint that receives Strapi revalidation webhooks.
WEBHOOKS_NEXTJS_TARGET=http://frontend:65100

# Public Next.js origin used by Strapi Preview links.
PREVIEW_CLIENT_URL=http://us-alb.localhost:65102

# Server-only secret shared by Strapi Preview and Next.js.
PREVIEW_SECRET=replace-with-a-high-entropy-shared-secret

# Default administrator username created during bootstrap.
ADMIN_USER=admin

# Domain appended to ADMIN_USER for the bootstrap email address.
ADMIN_DOMAIN=example.com

# Password for the bootstrap administrator account.
ADMIN_PASSWORD=ChangeMe123

# Optional file path for sourcing ADMIN_PASSWORD through Docker secrets.
# ADMIN_PASSWORD_FILE=
