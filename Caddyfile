	handle_path /cms {
		reverse_proxy backend:65101
	}

	handle_path /cms/* {
		reverse_proxy backend:65101
	}

	handle /uploads/* {
		reverse_proxy backend:65101
	}

	handle {
		reverse_proxy frontend:65100
	}
}
