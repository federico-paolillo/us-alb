HOST=127.0.0.1
PORT=65101

# Public website origin used by Preview.
SITE_URL=http://127.0.0.1:65100

# Public CMS URL for direct local development.
CMS_PUBLIC_URL=http://127.0.0.1:65101

APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

REVALIDATION_HEADER=x-revalidation-secret
REVALIDATION_SECRET=super-secret-change-me
FRONTEND_INTERNAL_URL=http://127.0.0.1:65100

# Shared with Next.js Preview.
PREVIEW_SECRET=preview-secret-change me

# Default admin user created on bootstrap when absent.
# Password must be at least 8 chars with an uppercase letter and a number.

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123

# Optional Docker-secrets style override: set ADMIN_PASSWORD_FILE to a file path
# (e.g. /run/secrets/admin_password) to source the password from that file.
# ADMIN_PASSWORD_FILE=
