{
  "kind": "collectionType",
  "collectionName": "calendar_entries",
  "info": {
    "singularName": "calendar-entry",
    "pluralName": "calendar-entries",
    "displayName": "Calendar Entry"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "kind": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "match",
        "result",
        "event"
      ]
    },
    "startsAt": {
      "type": "datetime",
      "required": true
    },
    "competition": {
      "type": "string",
      "required": true,
      "maxLength": 160
    },
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 160
    },
    "homeTeam": {
      "type": "string",
      "maxLength": 160
    },
    "awayTeam": {
      "type": "string",
      "maxLength": 160
    },
    "homeScore": {
      "type": "integer",
      "min": 0
    },
    "awayScore": {
      "type": "integer",
      "min": 0
    },
    "venue": {
      "type": "string",
      "required": true,
      "maxLength": 200
    },
    "summary": {
      "type": "text",
      "required": true,
      "maxLength": 280
    },
    "callToAction": {
      "type": "component",
      "component": "content.call-to-action",
      "repeatable": false,
      "required": false
    }
  }
}
