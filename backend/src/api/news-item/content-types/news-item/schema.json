{
  "kind": "collectionType",
  "collectionName": "news",
  "info": {
    "singularName": "news-item",
    "pluralName": "news",
    "displayName": "News"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "identity": {
      "type": "component",
      "component": "identity.slug",
      "repeatable": false,
      "required": true
    },
    "category": {
      "type": "string",
      "required": true,
      "maxLength": 120
    },
    "summary": {
      "type": "text",
      "required": true,
      "maxLength": 280
    },
    "editorialDate": {
      "type": "date",
      "required": true
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "content": {
      "type": "blocks",
      "required": true
    },
    "featured": {
      "type": "boolean",
      "required": true,
      "default": false
    }
  }
}
